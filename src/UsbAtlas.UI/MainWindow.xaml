<Window x:Class="UsbAtlas.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="USB Atlas">
  <Grid x:Name="Root" RequestedTheme="Dark" Language="en-US" Background="#151A20">
    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent" Padding="22,0,160,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE88E;" FontSize="16" Foreground="{StaticResource Accent}" /><TextBlock Text="USB ATLAS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="160" /><TextBlock Text="/  LOCAL · READ ONLY" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" /></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Padding="26,12,26,18" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding StatusTitle}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusBody}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
          <TextBlock Text="{Binding ScanTime}" FontSize="12" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" Header="Expert mode" OnContent="On" OffContent="Off" IsOn="{Binding Expert, Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="Shows technical details in each node." />
        <Button Grid.Column="2" Command="{Binding RefreshCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Padding="22,12" AutomationProperties.Name="Refresh USB devices"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="Refresh" FontWeight="SemiBold" /></StackPanel></Button>
      </Grid>
      <InfoBar Grid.Row="1" IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="Action could not be completed" Message="{Binding Error}" />
      <Grid Grid.Row="2" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
          <TextBlock Text="Your USB tree" FontSize="20" FontWeight="SemiBold" />
          <StackPanel x:Name="TopologyColorLegend" Orientation="Horizontal" Spacing="16" />
          <TextBlock Text="Controllers at the top · matching path colors link ports and devices · click a node for details · + / − to collapse branches" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Assessment details" Click="AssessmentDetails_Click" VerticalAlignment="Center" />
        <CheckBox Grid.Column="2" Content="Empty logical ports" IsChecked="{Binding ShowEmptyPorts, Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="Shows confirmed empty ports as compact, individually clickable cards below their hub." />
      </Grid>
      <Border Grid.Row="3" Background="#171D24" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="4" IsHitTestVisible="{Binding WorkEnabled}">
        <ScrollViewer x:Name="MapViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" ZoomMode="Disabled" SizeChanged="MapViewport_SizeChanged">
          <Canvas x:Name="MapSurface" Background="#171D24" />
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Row="4" Spacing="8"><ProgressBar IsIndeterminate="{Binding Busy}" Height="2" /><TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
    </Grid>
  </Grid>
</Window>
